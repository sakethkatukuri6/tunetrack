<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp">

    <!-- Queue Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAYING QUEUE"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvQueueTrackCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 tracks in queue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Shuffle / Clear Queue Action -->
        <Button
            android:id="@+id/btnClearQueue"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Clear"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </RelativeLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyQueue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Playback queue is empty.\nPick songs from your library to start listening."
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:paddingTop="60dp"
        android:visibility="gone" />

    <!-- Queue List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCurrentQueue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>

