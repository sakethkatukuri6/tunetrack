<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12101E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

        <!-- 1. Theme Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_album_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appearance &amp; Theme"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#BB86FC"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/rgTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Light Mode"
                    android:textColor="#E0E0E0"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/rbDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dark Mode"
                    android:textColor="#E0E0E0"
                    android:padding="8dp" />

                <RadioButton
                    android:id="@+id/rbSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Follow System Default"
                    android:textColor="#E0E0E0"
                    android:padding="8dp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 2. LAN Audio Cast Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_album_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LAN Audio Cast Server"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#03DAC6"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvLanIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server URL: http://192.168.1.45:8080"
                android:textSize="14sp"
                android:textColor="#B3FFFFFF"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnOpenLanModal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View LAN Cast QR &amp; Sync Info"
                android:backgroundTint="#03DAC6"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- 3. Audio & Equalizer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_album_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Equalizer &amp; Sound Profile"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#BB86FC"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvEqStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Preset: Balanced Studio"
                android:textSize="14sp"
                android:textColor="#B3FFFFFF"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEqBass"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bass"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnEqRock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rock"
                    android:textSize="12sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnEqFlat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Flat"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. About Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_album_card"
            android:padding="18dp"
            android:layout_marginBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Music Player"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Version 1.0.0 (API 28+ Native Android)\nDynamic Cover Art Backgrounds &amp; LAN Audio Cast"
                android:textSize="13sp"
                android:textColor="#80FFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

